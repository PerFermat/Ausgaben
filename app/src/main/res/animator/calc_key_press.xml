<?xml version="1.0" encoding="utf-8"?>
<!-- 3D-Druckeffekt der Rechentastatur-Tasten: erhöht mit Schatten im Ruhezustand, beim Drücken sofort
     flach/eingesunken (android:duration="0" = kein Überblenden, reiner Zustandswechsel). Läuft über
     translationZ/-Y statt über eine gemalte Hintergrund-Drawable, damit AccentColor.retintMaterialButton
     (das den Hintergrund per backgroundTint einfärbt) den Effekt nicht überschreibt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="0"
                android:valueTo="0dp"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationY"
                android:duration="0"
                android:valueTo="2dp"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="0"
                android:valueTo="4dp"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationY"
                android:duration="0"
                android:valueTo="0dp"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
