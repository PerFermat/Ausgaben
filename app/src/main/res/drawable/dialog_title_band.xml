<?xml version="1.0" encoding="utf-8"?>
<!-- Kopfband der Dialoge: grün wie die Titelleiste der App. Oben dieselbe Rundung wie der Dialog
     selbst (16dp), unten eckig – der Dialoghintergrund schneidet seine Kinder nicht zu, das Band
     muss seine Ecken also selbst mitbringen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/green_primary" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
