<?xml version="1.0" encoding="utf-8"?>
<!-- Die gelernten Erkennungsregeln von Hand nachbessern; oben die Wahl der Vorlage.

     FrameLayout als Wurzel wie in der Erfassungsmaske, damit die eigene Rechentastatur ueber dem
     Formular schweben kann: das Feld fuer die feste Gebuehr ist ein Betragsfeld und wird mit
     derselben Tastatur bedient wie jedes andere. Die System-Tastatur taugt dafuer nicht - ihr
     Ziffernblock kennt nur den Punkt und verschluckt das Komma. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/green_primary"
        android:theme="@style/ThemeOverlay.Ausgaben.Toolbar"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/statement_rules"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/statement_rules_none"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/templateLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/statement_rules_template">

                <de.spahr.ausgaben.ui.PickerTextView
                    android:id="@+id/editTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Die Testabrechnung steht oben, nicht unten: sie ist die Messlatte fuer alles, was
                 darunter folgt, und jeder Bereich zeigt an seiner Ueberschrift, was er darin findet. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTry"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/statement_rules_pick_test"
                android:textColor="@color/button_accent"
                app:icon="@drawable/ic_pdf"
                app:iconTint="@color/button_accent"
                app:strokeColor="@color/button_accent" />

            <!-- Erst sichtbar, wenn eine Testabrechnung gewaehlt ist - vorher haetten beide nichts
                 zu zeigen. -->
            <LinearLayout
                android:id="@+id/testButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowPdf"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/statement_rules_show_pdf"
                    android:textColor="@color/button_accent"
                    app:strokeColor="@color/button_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowText"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/statement_rules_show_text"
                    android:textColor="@color/button_accent"
                    app:strokeColor="@color/button_accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/textTestFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/fieldContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/statement_rules_delete"
                android:textColor="@color/expense_red"
                app:strokeColor="@color/expense_red" />

        </LinearLayout>
    </ScrollView>

    <!-- Haelt im Hochformat die Hoehe der Tastatur frei, damit nichts hinter ihr verschwindet;
         quer bleibt er verborgen. Gesteuert von der Tastatur selbst. -->
    <Space
        android:id="@+id/calcSpacer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>

    <!-- Eigene Rechentastatur; nur sichtbar, wenn das Betragsfeld aktiv ist. -->
    <de.spahr.ausgaben.ui.CalcKeyboardView
        android:id="@+id/calcKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:paddingHorizontal="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone" />
</FrameLayout>
