<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/green_primary"
    android:paddingStart="10dp"
    android:paddingEnd="4dp"
    android:paddingVertical="8dp">

    <!-- Das Emblem ist zugleich die Schaltfläche für die Kontensuche; die Lupe liegt darüber. Die
         Fläche ist bewusst größer als das Bild, damit man sie im ersten Anlauf trifft. -->
    <FrameLayout
        android:id="@+id/accountSearchButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:padding="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/accounts_search_hint">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <ImageView
            android:id="@+id/accountSearchIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/accounts_search_hint"
            app:tint="@android:color/black" />
    </FrameLayout>

    <!-- Antippen öffnet die Auswahl der Kontengruppe. Nur so breit wie nötig, damit das Dreieck am Wort
         hängt und nicht am Zahnrad; die Restbreite füllt der Platzhalter dahinter. -->
    <TextView
        android:id="@+id/accountGroupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="150dp"
        android:layout_marginStart="8dp"
        android:paddingVertical="8dp"
        android:text="@string/accounts_title"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:drawablePadding="2dp"
        app:drawableEndCompat="@drawable/ic_arrow_drop_down"
        app:drawableTint="@color/white"
        android:background="?attr/selectableItemBackground" />

    <View
        android:id="@+id/accountTitleSpacer"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- Tritt während der Suche an die Stelle der Überschrift; flüchtig, wird nie gespeichert. -->
    <EditText
        android:id="@+id/accountSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:paddingVertical="8dp"
        android:background="@null"
        android:hint="@string/accounts_search_hint"
        android:textColor="@color/white"
        android:textColorHint="#B2FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:visibility="gone"
        android:autofillHints="" />

    <ImageView
        android:id="@+id/manageAccounts"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_settings"
        android:contentDescription="@string/accounts_manage_title"
        app:tint="@color/white"
        android:background="?attr/selectableItemBackground" />
</LinearLayout>
